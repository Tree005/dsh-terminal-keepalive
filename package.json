{
  "name": "dsh-terminal-keepalive",
  "version": "0.3.0",
  "private": true,
  "description": "Keep the DSH right-sidebar terminal mounted across tab switches so it no longer reloads.",
  "keywords": ["dsh", "dsh-plugin", "terminal", "keepalive"],
  "repository": { "type": "git", "url": "git+https://github.com/Tree005/dsh-terminal-keepalive.git" },
  "homepage": "https://github.com/Tree005/dsh-terminal-keepalive#readme",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
